APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

BING_SEARCH_API_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Email Intelligence ─────────────────────────────────────────────
# Breach exposure check via the official Have I Been Pwned v3 API.
# Leave empty to disable (UI will show "Breach check is not configured").
# Key: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=
# Optional GitHub token — raises the GitHub code-search API rate limit.
# Without it, GitHub checks may report a rate-limit error on busy periods.
GITHUB_TOKEN=
# Optional overrides (defaults shown):
# EMAIL_INTEL_ENABLED=true
# EMAIL_INTEL_CONNECT_TIMEOUT=5
# EMAIL_INTEL_REQUEST_TIMEOUT=10
# EMAIL_INTEL_SCAN_LIMIT=6
# EMAIL_INTEL_CACHE_DNS=300
# EMAIL_INTEL_CACHE_GRAVATAR=1800
# EMAIL_INTEL_CACHE_GITHUB=600
# EMAIL_INTEL_CACHE_HIBP=3600
# EMAIL_INTEL_MAX_IDENTIFIER_CANDIDATES=2
# EMAIL_INTEL_MAX_IDENTIFIER_PLATFORMS=12
# EMAIL_INTEL_MAX_WEB_EVIDENCE=10
# EMAIL_INTEL_MAX_MAIL_IPS=6
# EMAIL_INTEL_MAX_BREACHES=20
# EMAIL_INTEL_DOH_URL="https://dns.google/resolve"
# HIBP_BASE_URL="https://haveibeenpwned.com/api/v3"
# HIBP_TIMEOUT=10
